 func fnSync(ce *commands.Event) {
 	login := ce.User.GetDefaultLogin()
+	// Relay patch: `--login=<login ID>` picks which account to sync with (default: the first one).
+	// Profile photos restricted to "my contacts" can only be fetched by the account that has the
+	// contact's privacy token, so resyncing through the right account matters.
+	for i, arg := range ce.Args {
+		if loginID, ok := strings.CutPrefix(arg, "--login="); ok {
+			if explicit := ce.Bridge.GetCachedUserLoginByID(networkid.UserLoginID(loginID)); explicit != nil && explicit.UserMXID == ce.User.MXID {
+				login = explicit
+			} else {
+				ce.Reply("Login `%s` not found", loginID)
+				return
+			}
+			ce.Args = append(ce.Args[:i:i], ce.Args[i+1:]...)
+			break
+		}
+	}
 	if login == nil {
 		ce.Reply("Login not found")
 		return
